# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyc
*$py.class

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Environments & Virtualenvs
.venv/
venv/
ENV/
env/

# Packaging & Build Distribution
dist/
build/
*.egg-info/
*.egg

# ArduPilot / SITL Runtime Artifacts & Logs
logs/
terrain/
eeprom.bin
mav.parm
mav.tlog
mav.tlog.raw
*.bin
*.log
*.raw
/runs/console/
# Timestamped SITL evidence directories are local artifacts. Keep compact batch summaries,
# reproducible configs, and the evidence index under runs/ available for version control.
/runs/independent/[0-9]*/
/runs/independent/external-sitl-*/
/runs/independent/multihost-sitl-*/
# Per-run HMAC secrets are reproducible test material; never publish them with evidence logs.
/runs/independent/**/*.key

# Local Archives & Backups
*.tar.gz

# Diagnostic Run Scripts
sitl/takeoff.scr

# Large Binaries & Ground Station App
*.AppImage
qgroundcontrol-app/
